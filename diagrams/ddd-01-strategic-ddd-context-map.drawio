    <mxCell id="inventory-sales" value="上游 → 下游；&#xa;&#xa;预留或拒绝；&#xa;&#xa;客户—供应方；&#xa;&#xa;翻译：销售订单本地语言适&#xa;&#xa;配；&#xa;&#xa;失败：不能猜测库存已预留" edge="1" parent="1" source="context-inventory-promise" target="context-sales-order" style="html=0;whiteSpace=nowrap;fontFamily=Noto Sans SC;fontSize=15;fontColor=#172b4d;labelBackgroundColor=#f3f6fb;align=left;verticalAlign=top;labelWidth=185;endArrow=block;startArrow=none;endFill=1;endSize=12;strokeColor=#71839b;strokeWidth=2;exitX=0.5;exitY=0;entryX=0.25;entryY=0;rounded=0;shape=connector;convertToSvg=1;fontStyle=0;spacing=0;spacingLeft=0;spacingTop=0;spacingRight=0;spacingBottom=0;labelPadding=7;"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="270"/><mxPoint x="385" y="270"/></Array><mxPoint x="-89" y="35" as="offset"/></mxGeometry></mxCell>
    <mxCell id="payment-sales" value="上游 → 下游；&#xa;&#xa;资金确认或未知结果；&#xa;&#xa;客户—供应方；&#xa;&#xa;翻译：销售订单本地语言适配；&#xa;&#xa;失败：未知结果回到支付结算查&#xa;&#xa;询" edge="1" parent="1" source="context-payment-settlement" target="context-sales-order" style="html=0;whiteSpace=nowrap;fontFamily=Noto Sans SC;fontSize=15;fontColor=#172b4d;labelBackgroundColor=#f3f6fb;align=left;verticalAlign=top;labelWidth=214;endArrow=block;startArrow=none;endFill=1;endSize=12;strokeColor=#71839b;strokeWidth=2;exitX=1;exitY=0.2;entryX=0;entryY=0.7;rounded=0;shape=connector;convertToSvg=1;fontStyle=0;spacing=0;spacingLeft=0;spacingTop=0;spacingRight=0;spacingBottom=0;labelPadding=7;"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="1040"/><mxPoint x="305" y="615.8"/></Array><mxPoint x="27" y="-34" as="offset"/></mxGeometry></mxCell>
    <mxCell id="sales-fulfillment" value="上游 → 下游；&#xa;&#xa;已接受商业承诺；&#xa;&#xa;开放主机服务＋&#xa;&#xa;发布语言；&#xa;&#xa;翻译：履约配送入口；&#xa;&#xa;失败：等待确认事实而非&#xa;&#xa;重判订单" edge="1" parent="1" source="context-sales-order" target="context-fulfillment-delivery" style="html=0;whiteSpace=nowrap;fontFamily=Noto Sans SC;fontSize=15;fontColor=#172b4d;labelBackgroundColor=#f3f6fb;align=left;verticalAlign=top;labelWidth=170;endArrow=block;startArrow=none;endFill=1;endSize=12;strokeColor=#71839b;strokeWidth=2;exitX=0.75;exitY=0;entryX=0.5;entryY=0;rounded=0;shape=connector;convertToSvg=1;fontStyle=0;spacing=0;spacingLeft=0;spacingTop=0;spacingRight=0;spacingBottom=0;labelPadding=7;"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="250"/><mxPoint x="690" y="250"/></Array><mxPoint x="-87" y="25" as="offset"/></mxGeometry></mxCell>
